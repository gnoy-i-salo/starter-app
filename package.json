{
  "name": "@starter-app/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/run-workspaces.mjs build",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint 'apps/**/*.scss' 'packages/**/*.scss' --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/run-workspaces.mjs typecheck && tsc -p tooling/tsconfig.json",
    "test": "node scripts/run-tests.mjs unit",
    "test:watch": "vitest",
    "test:harness": "node --test scripts/*.test.mjs",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "architecture": "likec4 start architecture",
    "architecture:export": "likec4 export json --skip-layout --pretty -o .cache/architecture.json architecture",
    "check:architecture": "pnpm architecture:export && node scripts/check-architecture.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check": "node scripts/check.mjs --all",
    "check:changed": "node scripts/check.mjs --changed",
    "check:staged": "node scripts/check.mjs --staged",
    "check:package": "node scripts/check.mjs --package",
    "commitlint": "commitlint",
    "beads:init": "bd init --prefix starter --skip-hooks --skip-agents --non-interactive --init-if-missing",
    "beads:ready": "bd ready --json",
    "beads:export": "bd export -o .beads/issues.jsonl",
    "check:rust": "node scripts/run-workspaces.mjs check:rust"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.19.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "likec4": "1.60.0",
    "prettier": "^3.8.1",
    "sass": "^1.108.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.0"
  }
}
